# =========================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
# =========================================================

# ---------- Postgres ----------
POSTGRES_USER=trackmystuff
POSTGRES_PASSWORD=changeme_in_dev
POSTGRES_DB=trackmystuff

# ---------- Backend ----------
# DATABASE_URL uses the docker-compose service name `db`
DATABASE_URL=postgresql://trackmystuff:changeme_in_dev@db:5432/trackmystuff
BACKEND_PORT=4000
NODE_ENV=development
# Generate a long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace_with_long_random_string
FRONTEND_URL=http://localhost:5173

# ---------- Discord OAuth2 ----------
# Create an app at https://discord.com/developers/applications
# Add the redirect URI below in OAuth2 settings
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/auth/callback

# ---------- Discord Bot Notifications ----------
# Bot token from Discord Developer Portal → your app → Bot → Reset Token.
# NOT the same as DISCORD_CLIENT_SECRET. Leave blank to disable notifications.
DISCORD_BOT_TOKEN=
# Snowflake ID of the channel the bot posts to.
DISCORD_NOTIFICATION_CHANNEL_ID=
# Your own Discord user ID (enable Developer Mode → right-click yourself → Copy User ID).
# Only this user's events / timed todos / dated plan items are summarized.
NOTIFICATION_DISCORD_USER_ID=
# Cron expression + timezone for the daily summary. Default fires at 08:30 America/Sao_Paulo.
NOTIFICATION_CRON=30 8 * * *
NOTIFICATION_TZ=America/Sao_Paulo

# ---------- Discord Slash-Command Bot ----------
# Snowflake ID of the guild (server) where slash commands will be registered.
# With Developer Mode on, right-click the server icon → Copy Server ID.
DISCORD_GUILD_ID=
# Shared secret between the bot service and the backend. Any random string,
# 16+ chars. Generate with `openssl rand -hex 32`. Both services must share
# the SAME value. Leave blank to disable /bot endpoints server-side.
BOT_API_SECRET=
# Note: the bot service reuses DISCORD_BOT_TOKEN and DISCORD_CLIENT_ID from
# the OAuth section above — no separate credentials needed.

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:4000
FRONTEND_PORT=5173
